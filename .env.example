# Postgres connection string, e.g. postgres://user:pass@db:5432/workespoo
DATABASE_URL=
# Public base URL of the app, used for links and QR codes
APP_URL=
# development | test | production (set by tooling)
NODE_ENV=
# Git commit hash, injected at build time and shown by /api/health
GIT_COMMIT=
# Passcode for the organiser area
ORGANISER_PASSCODE=
# Secret used to sign session cookies (long random string)
SESSION_SECRET=
# LLM gateway mode: live | record | replay (default replay in tests, else live)
LLM_MODE=
# Model for the live interviewer, as provider:model
LLM_LIVE=
# Model for analysis tasks, as provider:model
LLM_ANALYST=
# Model for bulk tasks, as provider:model
LLM_BULK=
# NVIDIA OpenAI-compatible base URL (default https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=
# NVIDIA API key
NVIDIA_API_KEY=
# Verda OpenAI-compatible base URL
VERDA_BASE_URL=
# Verda API key
VERDA_API_KEY=
# Custom OpenAI-compatible endpoint base URL
CUSTOM_LLM_BASE_URL=
# Custom endpoint API key
CUSTOM_LLM_API_KEY=
# ElevenLabs API key
ELEVENLABS_API_KEY=
# Voice adapter: elevenlabs | browser | none
VOICE_ADAPTER=
# Hours before a live demo session is purged (default 24)
LIVE_SESSION_TTL_HOURS=

# --- Model gateway tuning (all optional) ---
# LLM_LIVE, LLM_ANALYST and LLM_BULK each take one or more provider:model entries, comma-separated,
# tried in order. Example: LLM_LIVE=verda:deepseek-v4.1-flash,nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
# JSON merged into every request for a role. Use by_provider to switch reasoning off per provider, e.g.
# {"by_provider":{"nvidia":{"chat_template_kwargs":{"enable_thinking":false}}}}
LLM_EXTRA_BODY_LIVE=
LLM_EXTRA_BODY_ANALYST=
LLM_EXTRA_BODY_BULK=
# json_object (default), json_schema or none
LLM_JSON_MODE=
# Requests per minute the whole key may send to NVIDIA (default 30)
NVIDIA_MAX_RPM=
# Requests per minute the whole key may send to Verda (default 36)
VERDA_MAX_RPM=
# Requests per minute for a custom provider (default 0, no per-minute limit)
CUSTOM_LLM_MAX_RPM=
# This process's share of those limits, 0 to 1, so web and worker can split one key (default 1)
LLM_RPM_SHARE=
# Concurrent model requests per provider (default 8)
LLM_MAX_CONCURRENCY=
# Slots kept free for live calls; analyst and bulk never use them (default 2)
LLM_LIVE_RESERVE_SLOTS=
# Requests per minute kept free for live calls (default 6)
LLM_LIVE_RESERVE_RPM=
# Where recorded model responses live (default fixtures/llm)
LLM_FIXTURES_DIR=

# --- Voice (optional) ---
ELEVENLABS_VOICE_ID=
# Text-to-speech model (default eleven_flash_v2_5)
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=
